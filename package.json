{
  "name": "pi-antigravity-multi-account",
  "version": "0.1.0",
  "description": "Multi-account management extension for pi-antigravity and Pi coding agent",
  "main": "src/index.ts",
  "type": "module",
  "author": "andrraa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrraa/pi-antigravity.git"
  },
  "bugs": {
    "url": "https://github.com/andrraa/pi-antigravity/issues"
  },
  "homepage": "https://github.com/andrraa/pi-antigravity#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "antigravity",
    "google-cloud-code",
    "multi-account"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck"
  },
  "pi": {
    "extensions": [
      "./src/index.ts",
      "./node_modules/pi-antigravity/src/index.ts"
    ]
  },
  "allowScripts": {
    "@google/genai": true,
    "protobufjs": true
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "pi-antigravity": "^0.4.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
